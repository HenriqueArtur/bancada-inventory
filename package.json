{
  "name": "@bancada/inventory",
  "version": "0.1.0",
  "description": "Inventory plugin for bancada: what you own, how much, and what each lesson consumes",
  "keywords": [
    "bancada",
    "bancada-plugin",
    "inventory",
    "stock"
  ],
  "homepage": "https://github.com/HenriqueArtur/bancada-inventory#readme",
  "bugs": {
    "url": "https://github.com/HenriqueArtur/bancada-inventory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenriqueArtur/bancada-inventory.git"
  },
  "license": "MIT",
  "author": "Henrique Artur <contato@henriqueartur.com>",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "bancada": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bun": "1.3.14",
    "bancada": "0.1.0",
    "typescript": "5.9.3"
  }
}
